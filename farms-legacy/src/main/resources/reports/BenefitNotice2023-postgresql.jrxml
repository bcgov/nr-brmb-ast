  <subDataset name="DS_BPU_STRUCTURAL_CHANGE" uuid="6f39e713-9b14-4d4a-89ca-899036e1f6ec">
    <property name="com.jaspersoft.studio.data.sql.tables" value="" />
    <parameter name="IN_SCENARIO_ID" class="java.lang.Integer">

    </parameter>
    <parameter name="V_YEAR" class="java.lang.Integer">
      <defaultValueExpression><![CDATA[2025]]></defaultValueExpression>
    </parameter>
    <queryString language="SQL">SELECT
    COALESCE(CAST(bpu.inventory_item_code AS text), CAST(bpu.structure_group_code AS text)) AS bpu_code,
    CASE
        WHEN bpu.inventory_item_code IS NOT NULL
        THEN iic.description
        ELSE sgc.description
    END AS bpu_description,
    MAX(CASE
        WHEN byear.benchmark_year = ($P{V_YEAR} - 5)
        THEN byear.average_margin
    END) AS year_minus_5_margin,
    MAX(CASE
        WHEN byear.benchmark_year = ($P{V_YEAR} - 4)
        THEN byear.average_margin
    END) AS year_minus_4_margin,
    MAX(CASE
        WHEN byear.benchmark_year = ($P{V_YEAR} - 3)
        THEN byear.average_margin
    END) AS year_minus_3_margin,
    MAX(CASE
        WHEN byear.benchmark_year = ($P{V_YEAR} - 2)
        THEN byear.average_margin
    END) AS year_minus_2_margin,
    MAX(CASE
        WHEN byear.benchmark_year = ($P{V_YEAR} - 1)
        THEN byear.average_margin
    END) AS year_minus_1_margin
FROM farms.farm_scenario_bpu_xref x
JOIN farms.farm_benchmark_per_units bpu
    ON bpu.benchmark_per_unit_id = x.benchmark_per_unit_id
JOIN farms.farm_benchmark_years byear
    ON byear.benchmark_per_unit_id = bpu.benchmark_per_unit_id
LEFT JOIN farms.farm_inventory_item_codes iic
    ON iic.inventory_item_code = bpu.inventory_item_code
LEFT JOIN farms.farm_structure_group_codes sgc
    ON sgc.structure_group_code = bpu.structure_group_code
WHERE x.agristability_scenario_id = $P{IN_SCENARIO_ID}
  AND x.scenario_bpu_purpose_code = 'STANDARD'
  AND byear.benchmark_year BETWEEN ($P{V_YEAR} - 5)
                               AND ($P{V_YEAR} - 1)
GROUP BY
    COALESCE(CAST(bpu.inventory_item_code AS text), CAST(bpu.structure_group_code AS text)),
    CASE
        WHEN bpu.inventory_item_code IS NOT NULL
        THEN iic.description
        ELSE sgc.description
    END
ORDER BY bpu_code</queryString>
    <field name="BPU_CODE" class="java.lang.String">
      <property name="com.jaspersoft.studio.field.label" value="BPU_CODE" />
    </field>
    <field name="BPU_DESCRIPTION" class="java.lang.String">
      <property name="com.jaspersoft.studio.field.label" value="BPU_DESCRIPTION" />
    </field>
    <field name="YEAR_MINUS_5_MARGIN" class="java.math.BigDecimal">
      <property name="com.jaspersoft.studio.field.label" value="YEAR_MINUS_5_MARGIN" />
    </field>
    <field name="YEAR_MINUS_4_MARGIN" class="java.math.BigDecimal">
