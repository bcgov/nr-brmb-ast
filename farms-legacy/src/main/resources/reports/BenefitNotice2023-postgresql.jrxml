  <subDataset name="DS_PROD_MARGIN" uuid="fec9fd18-8d3f-4ca2-9fb0-c81013ef1862">
    <property name="com.jaspersoft.studio.data.sql.tables" value="" />
    <parameter name="IN_SCENARIO_ID" class="java.lang.Integer" />
    <queryString language="SQL">select
  py.year,
  bct.unadjusted_production_margin,
  bct.production_marg_accr_adjs,
  CASE WHEN cl.Structural_Change_Code != 'NONE' AND pbct.Structural_Change_Notable_Ind = 'Y'
                THEN bct.structural_change_adjs ELSE 0 END structural_change_adjs,
  bct.production_marg_aft_str_changs,
  CASE WHEN bct.production_marg_accr_adjs = 0 THEN 0 ELSE ROUND((CAST(bct.production_marg_aft_str_changs AS numeric) / ABS(CAST(bct.production_marg_accr_adjs AS numeric))) * 100, 0) END sca_percent_change,
  refs.used_in_calc_ind,
  bct.accrual_adjs_crop_inventory change_in_crops,
  bct.accrual_adjs_lvstck_inventory change_in_livestock,
  bct.accrual_adjs_purchased_inputs change_in_pi,
  bct.accrual_adjs_receivables change_in_diar,
  bct.accrual_adjs_payables change_in_ap
from farms.farm_reference_scenarios refs
join farms.farm_agristability_scenarios fas on fas.agristability_scenario_id = refs.agristability_scenario_id
join farms.farm_program_year_versions pyv on fas.program_year_version_id = pyv.program_year_version_id
join farms.farm_program_years py on py.program_year_id = pyv.program_year_id
join farms.farm_benefit_calc_totals bct on bct.agristability_scenario_id = fas.agristability_scenario_id
join farms.farm_benefit_calc_totals pbct on pbct.agristability_scenario_id = refs.for_agristability_scenario_id
join farms.farm_agristability_claims cl on cl.agristability_scenario_id = refs.for_agristability_scenario_id
where refs.for_agristability_scenario_id = $P{IN_SCENARIO_ID}
union
select
  py.year,
  bct.unadjusted_production_margin,
  bct.production_marg_accr_adjs,
  null structural_change_adjs,
  null production_marg_aft_str_changs,
  null sca_percent_change,
  null used_in_calc_ind,
  bct.accrual_adjs_crop_inventory change_in_crops,
  bct.accrual_adjs_lvstck_inventory change_in_livestock,
  bct.accrual_adjs_purchased_inputs change_in_pi,
  bct.accrual_adjs_receivables change_in_diar,
  bct.accrual_adjs_payables change_in_ap
from farms.farm_program_years py
join farms.farm_program_year_versions pyv on pyv.program_year_id = py.program_year_id
join farms.farm_agristability_clients ac on ac.agristability_client_id = py.agristability_client_id
join farms.farm_agristability_scenarios fas on fas.program_year_version_id = pyv.program_year_version_id
join farms.farm_benefit_calc_totals bct on bct.agristability_scenario_id = fas.agristability_scenario_id
where fas.agristability_scenario_id = $P{IN_SCENARIO_ID}
order by year ASC</queryString>
