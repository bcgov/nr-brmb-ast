  <subDataset name="DS_INCOME" uuid="289b7161-d411-401f-a43c-264a45278595">
    <property name="com.jaspersoft.studio.data.sql.tables" value="" />
    <parameter name="IN_SCENARIO_ID" class="java.lang.Integer">

    </parameter>
    <parameter name="V_YEAR" class="java.lang.Integer">
      <defaultValueExpression><![CDATA[2025]]></defaultValueExpression>
    </parameter>
    <queryString language="SQL">with state_history as (
  select max(ssa.when_created) verified_date
  from farms.farm_scenario_state_audits ssa
  where ssa.agristability_scenario_id = $P{IN_SCENARIO_ID}
    and ssa.scenario_state_code = 'COMP'
)
select
  max(case when description_rank = 1 then description end)
    income_description,
  income_code,
  sum(year_minus_5_grower_income) year_minus_5_income,
  sum(year_minus_4_grower_income) year_minus_4_income,
  sum(year_minus_3_grower_income) year_minus_3_income,
  sum(year_minus_2_grower_income) year_minus_2_income,
  sum(year_minus_1_grower_income) year_minus_1_income,
  sum(year_grower_income) year_income
from (
  select
    description,
    income_code,
    year_minus_5_grower_income,
    year_minus_4_grower_income,
    year_minus_3_grower_income,
    year_minus_2_grower_income,
    year_minus_1_grower_income,
    year_grower_income,
    grower_percent,
    rank() over (
      partition by income_code
      order by year desc
    ) description_rank
  from (
    select
      li.description,
      li.line_item income_code,
      case
        when py.year = $P{V_YEAR}-5 then ries.amount
        else null
      end year_minus_5_grower_income,
      case
        when py.year = $P{V_YEAR}-4 then ries.amount
        else null
      end year_minus_4_grower_income,
      case
        when py.year = $P{V_YEAR}-3 then ries.amount
        else null
      end year_minus_3_grower_income,
      case
        when py.year = $P{V_YEAR}-2 then ries.amount
        else null
      end year_minus_2_grower_income,
      case
        when py.year = $P{V_YEAR}-1 then ries.amount
        else null
      end year_minus_1_grower_income,
      null year_grower_income,
      fos.partnership_percent grower_percent,
      py.year
    from farms.farm_scenarios_vw ps
    join farms.farm_reference_scenarios refs
      on refs.for_agristability_scenario_id =
         ps.agristability_scenario_id
    join farms.farm_agristability_scenarios fas
      on fas.agristability_scenario_id =
         refs.agristability_scenario_id
    join farms.farm_program_year_versions pyv
      on fas.program_year_version_id =
         pyv.program_year_version_id
    join farms.farm_program_years py
      on py.program_year_id = pyv.program_year_id
    join farms.farm_farming_operations fos
      on fos.program_year_version_id =
         pyv.program_year_version_id
    join farms.farm_reported_income_expenses ries
      on ries.farming_operation_id =
         fos.farming_operation_id
    join farms.farm_line_items li
      on li.line_item = ries.line_item
    where ps.agristability_scenario_id = $P{IN_SCENARIO_ID}
      and (
        ries.agristability_scenario_id is null
        or ries.agristability_scenario_id =
           fas.agristability_scenario_id
      )
      and ries.expense_ind = 'N'
      and (
        li.eligibility_ind = 'Y'
        or li.eligibility_for_ref_years_ind = 'Y'
      )
      and li.program_year = ps.year
      and (
        select verified_date
        from state_history
      ) between li.established_date and li.expiry_date

    union all

    select
      li.description,
      li.line_item income_code,
      null year_minus_5_grower_income,
      null year_minus_4_grower_income,
      null year_minus_3_grower_income,
      null year_minus_2_grower_income,
      null year_minus_1_grower_income,
      ries.amount year_grower_income,
      fos.partnership_percent grower_percent,
      py.year
    from farms.farm_agristability_scenarios fas
    join farms.farm_program_year_versions pyv
      on fas.program_year_version_id =
         pyv.program_year_version_id
    join farms.farm_program_years py
      on py.program_year_id = pyv.program_year_id
    join farms.farm_farming_operations fos
      on fos.program_year_version_id =
         pyv.program_year_version_id
    join farms.farm_reported_income_expenses ries
      on ries.farming_operation_id =
         fos.farming_operation_id
    join farms.farm_line_items li
      on li.line_item = ries.line_item
    where fas.agristability_scenario_id = $P{IN_SCENARIO_ID}
      and (
        ries.agristability_scenario_id is null
        or ries.agristability_scenario_id =
           fas.agristability_scenario_id
      )
      and ries.expense_ind = 'N'
      and li.eligibility_ind = 'Y'
      and li.program_year = py.year
      and (
        select verified_date
        from state_history
      ) between li.established_date and li.expiry_date
  ) AS pg_derived_2
) AS pg_derived_1
group by income_code
order by income_description</queryString>
