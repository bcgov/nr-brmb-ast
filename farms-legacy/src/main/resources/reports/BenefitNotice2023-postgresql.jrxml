    <field name="YEAR_MINUS_2_MANUAL_EXPENSE" class="java.math.BigDecimal">
      <property name="com.jaspersoft.studio.field.label" value="YEAR_MINUS_2_MANUAL_EXPENSE" />
    </field>
    <field name="YEAR_MINUS_1_MANUAL_EXPENSE" class="java.math.BigDecimal">
      <property name="com.jaspersoft.studio.field.label" value="YEAR_MINUS_1_MANUAL_EXPENSE" />
    </field>
    <field name="YEAR_MANUAL_EXPENSE" class="java.math.BigDecimal">
      <property name="com.jaspersoft.studio.field.label" value="YEAR_MANUAL_EXPENSE" />
    </field>
    <variable name="SUM_MANUAL_EXP_M5" class="java.math.BigDecimal" calculation="Sum">
      <variableExpression><![CDATA[$F{YEAR_MINUS_5_MANUAL_EXPENSE}]]></variableExpression>
      <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="SUM_MANUAL_EXP_M4" class="java.math.BigDecimal" calculation="Sum">
      <variableExpression><![CDATA[$F{YEAR_MINUS_4_MANUAL_EXPENSE}]]></variableExpression>
      <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
