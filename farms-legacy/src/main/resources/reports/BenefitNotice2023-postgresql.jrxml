      <property name="com.jaspersoft.studio.field.label" value="RECEIVABLE_CRA_END_AMOUNT" />
    </field>
    <field name="RECEIVABLE_ADJ_END_AMOUNT" class="java.math.BigDecimal">
      <property name="com.jaspersoft.studio.field.label" value="RECEIVABLE_ADJ_END_AMOUNT" />
    </field>
    <field name="RECEIVABLE_NEW_END_AMOUNT" class="java.math.BigDecimal">
      <property name="com.jaspersoft.studio.field.label" value="RECEIVABLE_NEW_END_AMOUNT" />
    </field>
  </subDataset>
  <subDataset name="DS_PAYABLE_ADJUSTMENTS" uuid="9ff379c4-528e-462f-9d62-0782b9b650a5">
    <property name="com.jaspersoft.studio.data.sql.tables" value="" />
    <parameter name="IN_SCENARIO_ID" class="java.lang.Integer">

    </parameter>
    <queryString language="SQL">select
  iic.inventory_item_code payable_item_code,
  iic.description payable_description,
  cra.end_of_year_amount payable_cra_end_amount,
  adj.end_of_year_amount payable_adj_end_amount,
  COALESCE(cra.end_of_year_amount, 0)
    + COALESCE(adj.end_of_year_amount, 0)
    payable_new_end_amount
from farms.farm_scenarios_vw sv
join farms.farm_agristability_scenarios s
  on s.agristability_scenario_id =
     sv.agristability_scenario_id
join farms.farm_farming_operations fo
  on fo.program_year_version_id =
     sv.program_year_version_id
join farms.farm_reported_inventories adj
  on adj.farming_operation_id =
     fo.farming_operation_id
 and adj.agristability_scenario_id =
     sv.agristability_scenario_id
left outer join farms.farm_reported_inventories cra
  on cra.reported_inventory_id =
     adj.cra_reported_inventory_id
join farms.farm_agristabilty_cmmdty_xref x
  on x.agristabilty_cmmdty_xref_id =
     adj.agristabilty_cmmdty_xref_id
join farms.farm_inventory_item_codes iic
  on iic.inventory_item_code =
     x.inventory_item_code
where sv.agristability_scenario_id =
      $P{IN_SCENARIO_ID}
  and x.inventory_class_code = '5'
  and adj.end_of_year_amount != 0
order by payable_item_code</queryString>
    <field name="PAYABLE_ITEM_CODE" class="java.lang.String">
      <property name="com.jaspersoft.studio.field.label" value="PAYABLE_ITEM_CODE" />
    </field>
    <field name="PAYABLE_DESCRIPTION" class="java.lang.String">
      <property name="com.jaspersoft.studio.field.label" value="PAYABLE_DESCRIPTION" />
    </field>
    <field name="PAYABLE_CRA_END_AMOUNT" class="java.math.BigDecimal">
      <property name="com.jaspersoft.studio.field.label" value="PAYABLE_CRA_END_AMOUNT" />
    </field>
    <field name="PAYABLE_ADJ_END_AMOUNT" class="java.math.BigDecimal">
      <property name="com.jaspersoft.studio.field.label" value="PAYABLE_ADJ_END_AMOUNT" />
    </field>
    <field name="PAYABLE_NEW_END_AMOUNT" class="java.math.BigDecimal">
