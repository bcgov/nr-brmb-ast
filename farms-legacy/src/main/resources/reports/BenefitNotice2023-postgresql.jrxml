    <variable name="SUM_YEAR_MINUS_5_INCOME" class="java.math.BigDecimal" calculation="Sum">
      <variableExpression><![CDATA[$F{YEAR_MINUS_5_INCOME}]]></variableExpression>
      <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="SUM_YEAR_MINUS_4_INCOME" class="java.math.BigDecimal" calculation="Sum">
      <variableExpression><![CDATA[$F{YEAR_MINUS_4_INCOME}]]></variableExpression>
      <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="SUM_YEAR_MINUS_3_INCOME" class="java.math.BigDecimal" calculation="Sum">
      <variableExpression><![CDATA[$F{YEAR_MINUS_3_INCOME}]]></variableExpression>
      <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="SUM_YEAR_MINUS_2_INCOME" class="java.math.BigDecimal" calculation="Sum">
      <variableExpression><![CDATA[$F{YEAR_MINUS_2_INCOME}]]></variableExpression>
      <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="SUM_YEAR_MINUS_1_INCOME" class="java.math.BigDecimal" calculation="Sum">
      <variableExpression><![CDATA[$F{YEAR_MINUS_1_INCOME}]]></variableExpression>
      <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="SUM_YEAR_INCOME" class="java.math.BigDecimal" calculation="Sum">
      <variableExpression><![CDATA[$F{YEAR_INCOME}]]></variableExpression>
      <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
  </subDataset>
  <subDataset name="DS_YARDAGE_INCOME" uuid="97d7cd8f-67d1-407c-a16e-6aaa3b3f9f33">
    <property name="com.jaspersoft.studio.data.sql.tables" value="" />
    <parameter name="IN_SCENARIO_ID" class="java.lang.Integer">

    </parameter>
    <parameter name="V_YEAR" class="java.lang.Integer">
      <defaultValueExpression><![CDATA[2025]]></defaultValueExpression>
    </parameter>
    <queryString language="SQL">select
  sum(year_minus_5_grower_income)
    year_minus_5_yardage_income,
  sum(year_minus_4_grower_income)
    year_minus_4_yardage_income,
  sum(year_minus_3_grower_income)
    year_minus_3_yardage_income,
  sum(year_minus_2_grower_income)
    year_minus_2_yardage_income,
  sum(year_minus_1_grower_income)
    year_minus_1_yardage_income,
  sum(year_grower_income)
    year_yardage_income
from (
  select
    case
      when py.year = $P{V_YEAR}-5 then bct.yardage_income
      else null
    end year_minus_5_grower_income,
    case
      when py.year = $P{V_YEAR}-4 then bct.yardage_income
      else null
    end year_minus_4_grower_income,
    case
      when py.year = $P{V_YEAR}-3 then bct.yardage_income
      else null
    end year_minus_3_grower_income,
    case
      when py.year = $P{V_YEAR}-2 then bct.yardage_income
      else null
    end year_minus_2_grower_income,
    case
      when py.year = $P{V_YEAR}-1 then bct.yardage_income
      else null
    end year_minus_1_grower_income,
    null year_grower_income
  from farms.farm_reference_scenarios refs
  join farms.farm_agristability_scenarios fas
    on fas.agristability_scenario_id =
       refs.agristability_scenario_id
  join farms.farm_program_year_versions pyv
    on fas.program_year_version_id =
       pyv.program_year_version_id
  join farms.farm_program_years py
    on py.program_year_id = pyv.program_year_id
  join farms.farm_benefit_calc_totals bct
    on bct.agristability_scenario_id =
       fas.agristability_scenario_id
  where refs.for_agristability_scenario_id =
        $P{IN_SCENARIO_ID}

  union all

  select
    null year_minus_5_grower_income,
    null year_minus_4_grower_income,
    null year_minus_3_grower_income,
    null year_minus_2_grower_income,
    null year_minus_1_grower_income,
    bct.yardage_income year_grower_income
  from farms.farm_agristability_scenarios fas
  join farms.farm_benefit_calc_totals bct
    on bct.agristability_scenario_id =
       fas.agristability_scenario_id
  where fas.agristability_scenario_id =
        $P{IN_SCENARIO_ID}
) AS pg_derived_1</queryString>
