  <subDataset name="DS_PRODUCTIVE_UNIT_ADJUSTMENTS" uuid="c56a07e1-6e1f-4c88-90a4-41863e1466b8">
    <property name="com.jaspersoft.studio.data.sql.tables" value="" />
    <parameter name="IN_SCENARIO_ID" class="java.lang.Integer">

    </parameter>
    <queryString language="SQL">with a as (
  select
    puc.productve_unit_capacity_id,
    puc.productive_capacity_amount,
    puc.farming_operation_id,
    puc.structure_group_code,
    puc.inventory_item_code
  from farms.farm_scenarios_vw sv
  join farms.farm_farming_operations fo
    on fo.program_year_version_id =
       sv.program_year_version_id
  join farms.farm_productve_unit_capacities puc
    on puc.farming_operation_id =
       fo.farming_operation_id
  where sv.agristability_scenario_id =
        $P{IN_SCENARIO_ID}
    and puc.agristability_scenario_id is null
),
b as (
  select
    puc.cra_productve_unit_capacity_id,
    puc.productive_capacity_amount,
    puc.farming_operation_id,
    puc.structure_group_code,
    puc.inventory_item_code
  from farms.farm_productve_unit_capacities puc
  where puc.agristability_scenario_id =
        $P{IN_SCENARIO_ID}
),
p as (
  select
    py.year,
    COALESCE(
      a.farming_operation_id,
      b.farming_operation_id
    ) farming_operation_id,
    sgc.structure_group_code,
    sgc.description structure_group_description,
    iic.inventory_item_code,
    iic.description inventory_item_description,
    a.productve_unit_capacity_id
      cra_productve_unit_capacity_id,
    a.productive_capacity_amount
      cra_productive_capacity_amount,
    b.productive_capacity_amount
      adj_productive_capacity_amount
  from a
  full outer join b
    on a.productve_unit_capacity_id =
       b.cra_productve_unit_capacity_id
  join farms.farm_farming_operations fo
    on fo.farming_operation_id =
       COALESCE(
         a.farming_operation_id,
         b.farming_operation_id
       )
  join farms.farm_program_year_versions pyv
    on pyv.program_year_version_id =
       fo.program_year_version_id
  join farms.farm_program_years py
    on py.program_year_id = pyv.program_year_id
  left outer join farms.farm_inventory_item_codes iic
    on a.inventory_item_code = iic.inventory_item_code
    or b.inventory_item_code = iic.inventory_item_code
  left outer join farms.farm_inventory_item_details iid
    on iic.inventory_item_code = iid.inventory_item_code
   and iid.program_year = py.year
  left outer join farms.farm_structure_group_codes sgc
    on a.structure_group_code = sgc.structure_group_code
    or b.structure_group_code = sgc.structure_group_code
),
bpu2 as (
  select
    x.inventory_item_code,
    x.structure_group_code,
    x.average_margin
  from (
    select
      bpu.municipality_code,
      max(bpu.municipality_code) over (
        partition by
          bpu.program_year,
          bpu.inventory_item_code,
          bpu.structure_group_code
      ) mx_municipality_code,
      bpu.inventory_item_code,
      bpu.structure_group_code,
      bnch.average_margin
    from farms.farm_benchmark_per_units bpu
    join farms.farm_benchmark_years bnch
      on bpu.benchmark_per_unit_id =
         bnch.benchmark_per_unit_id
     and bnch.benchmark_year = bpu.program_year - 1
    join farms.farm_agristability_scenarios sc
      on sc.agristability_scenario_id =
         $P{IN_SCENARIO_ID}
    join farms.farm_program_year_versions pyv
      on sc.program_year_version_id =
         pyv.program_year_version_id
     and (
       bpu.municipality_code = pyv.municipality_code
       or bpu.municipality_code = '0'
     )
    join farms.farm_program_years py
      on py.program_year_id = pyv.program_year_id
    where bpu.program_year = py.year
      and (
        bpu.expiry_date is null
        or bpu.expiry_date &gt;= LOCALTIMESTAMP(0)
      )
      and (
        bpu.inventory_item_code in (
          SELECT DISTINCT inventory_item_code
          from p
          where inventory_item_code is not null
        )
        or bpu.structure_group_code in (
          SELECT DISTINCT structure_group_code
          from p
          where structure_group_code is not null
        )
      )
  ) x
  where x.municipality_code = x.mx_municipality_code
)
select
  COALESCE(CAST(p.structure_group_code AS text), CAST(p.inventory_item_code AS text)) productive_unit_item_code,
  case
    when p.structure_group_code is not null
    then p.structure_group_description
    else p.inventory_item_description
  end productive_unit_description,
  p.cra_productive_capacity_amount
    productive_unit_cra_amount,
  p.adj_productive_capacity_amount
    productive_unit_adj_amount,
  COALESCE(p.cra_productive_capacity_amount, 0)
    + COALESCE(p.adj_productive_capacity_amount, 0)
    productive_unit_new_amount,
  bpu2.average_margin bpu_average_margin
from p
left outer join bpu2
  on bpu2.inventory_item_code = p.inventory_item_code
  or bpu2.structure_group_code = p.structure_group_code
order by CAST(COALESCE(CAST(p.structure_group_code AS text), CAST(p.inventory_item_code AS text)) AS numeric)</queryString>
    <field name="PRODUCTIVE_UNIT_ITEM_CODE" class="java.lang.String">
      <property name="com.jaspersoft.studio.field.label" value="PRODUCTIVE_UNIT_ITEM_CODE" />
    </field>
    <field name="PRODUCTIVE_UNIT_DESCRIPTION" class="java.lang.String">
      <property name="com.jaspersoft.studio.field.label" value="PRODUCTIVE_UNIT_DESCRIPTION" />
    </field>
    <field name="PRODUCTIVE_UNIT_CRA_AMOUNT" class="java.math.BigDecimal">
      <property name="com.jaspersoft.studio.field.label" value="PRODUCTIVE_UNIT_CRA_AMOUNT" />
    </field>
    <field name="PRODUCTIVE_UNIT_ADJ_AMOUNT" class="java.math.BigDecimal">
      <property name="com.jaspersoft.studio.field.label" value="PRODUCTIVE_UNIT_ADJ_AMOUNT" />
    </field>
    <field name="PRODUCTIVE_UNIT_NEW_AMOUNT" class="java.math.BigDecimal">
      <property name="com.jaspersoft.studio.field.label" value="PRODUCTIVE_UNIT_NEW_AMOUNT" />
    </field>
    <field name="BPU_AVERAGE_MARGIN" class="java.math.BigDecimal">
      <property name="com.jaspersoft.studio.field.label" value="BPU_AVERAGE_MARGIN" />
    </field>
  </subDataset>
  <subDataset name="DS_ADJUSTMENT_COUNTS" uuid="e2f66ac9-c12c-4f8b-9998-8c069f5ef66b">
    <property name="com.jaspersoft.studio.data.sql.tables" value="" />
    <parameter name="IN_SCENARIO_ID" class="java.lang.Integer">

    </parameter>
    <queryString language="SQL">select
  adj_income_count,
  adj_expense_count,
  adj_crop_count,
  adj_livestock_count,
  adj_input_count,
  adj_receivable_count,
  adj_payable_count,
  adj_prod_unit_count,
  (
    adj_income_count +
    adj_expense_count +
    adj_crop_count +
    adj_livestock_count +
    adj_input_count +
    adj_receivable_count +
    adj_payable_count +
    adj_prod_unit_count
  ) adj_total_count
from
(
  select
    count(case when adj.expense_ind = 'N' then 1 end)
      adj_income_count,
    count(case when adj.expense_ind = 'Y' then 1 end)
      adj_expense_count
  from farms.farm_scenarios_vw m
  join farms.farm_agristability_scenarios s
    on s.agristability_scenario_id =
       m.agristability_scenario_id
  join farms.farm_farming_operations fo
    on fo.program_year_version_id =
       m.program_year_version_id
  join farms.farm_reported_income_expenses adj
    on adj.farming_operation_id =
       fo.farming_operation_id
   and adj.agristability_scenario_id =
       m.agristability_scenario_id
  left outer join farms.farm_reported_income_expenses cra
    on cra.reported_income_expense_id =
       adj.cra_reported_income_expense_id
  where m.agristability_scenario_id = $P{IN_SCENARIO_ID}
    and adj.amount != 0
) inc_exp,
(
  select
    count(case when x.inventory_class_code = '1' then 1 end)
      adj_crop_count,
    count(case when x.inventory_class_code = '2' then 1 end)
      adj_livestock_count,
    count(case when x.inventory_class_code = '3' then 1 end)
      adj_input_count,
    count(case when x.inventory_class_code = '4' then 1 end)
      adj_receivable_count,
    count(case when x.inventory_class_code = '5' then 1 end)
      adj_payable_count
  from farms.farm_scenarios_vw m
  join farms.farm_agristability_scenarios s
    on s.agristability_scenario_id =
       m.agristability_scenario_id
  join farms.farm_farming_operations fo
    on fo.program_year_version_id =
       m.program_year_version_id
  join farms.farm_reported_inventories adj
    on adj.farming_operation_id =
       fo.farming_operation_id
   and adj.agristability_scenario_id =
       m.agristability_scenario_id
  join farms.farm_agristabilty_cmmdty_xref x
    on x.agristabilty_cmmdty_xref_id =
       adj.agristabilty_cmmdty_xref_id
  where m.agristability_scenario_id = $P{IN_SCENARIO_ID}
    and (
      (
        x.inventory_class_code in ('1', '2')
        and (
          adj.quantity_end != 0
          or adj.price_end != 0
        )
      )
      or (
        x.inventory_class_code in ('3', '4', '5')
        and adj.end_of_year_amount != 0
      )
    )
) inv,
(
  select
    count(*) adj_prod_unit_count
  from farms.farm_scenarios_vw m
  join farms.farm_agristability_scenarios s
    on s.agristability_scenario_id =
       m.agristability_scenario_id
  join farms.farm_farming_operations fo
    on fo.program_year_version_id =
       m.program_year_version_id
  join farms.farm_productve_unit_capacities adj
    on adj.farming_operation_id =
       fo.farming_operation_id
   and adj.agristability_scenario_id =
       m.agristability_scenario_id
  where m.agristability_scenario_id = $P{IN_SCENARIO_ID}
    and adj.productive_capacity_amount != 0
) puc</queryString>
