    </field>
  </subDataset>
  <parameter name="IN_SCENARIO_ID" class="java.lang.Integer">

  </parameter>
  <queryString>SELECT
    a.*,
    CASE
        WHEN a.benefit_after_interim_ded &gt; max_benefit
        THEN max_benefit
        ELSE a.benefit_after_interim_ded
    END benefit_before_combind_frm_pct,
    CASE
        WHEN a.enh_benefit_after_interim_ded &gt; enh_max_benefit
        THEN enh_max_benefit
        ELSE a.enh_benefit_after_interim_ded
    END enh_benefit_bfor_combn_frm_pct,
    (tier3_margin_decline + negative_margin_decline)
        margin_decline_from_trigger,
    (benefit_before_deductions - benefit_after_prod_insur_ded) * -1
        prod_insur_deduction,
    COALESCE(orig_bnft_after_late_enrol_penalty, benefit_after_payment_cap)
        bnft_after_late_enrol_penalty,
    COALESCE(orig_enh_bnft_aftr_late_enr_penalty, enh_benefit_after_payment_cap)
        enh_bnft_aftr_late_enr_penalty,
    COALESCE(enh_total_benefit, total_benefit) benefit_total
FROM (
    SELECT
        fas.agristability_scenario_id,
        ac.participant_pin,
        py.year,
        mc.description AS region,
        py.late_participant_ind,
        py.cash_margins_ind,
        psn.first_name,
        psn.last_name,
        psn.corp_name,
        psn.address_line_1,
        psn.address_line_2,
        COALESCE(psn.city, '') || ' ' || COALESCE(psn.province_state, '') || ' ' || COALESCE(psn.postal_code, '')
            city_prov_postal_code,
        cl.enh_ref_margin_for_beneft_calc,
        cl.adjusted_reference_margin,
        cl.margin_decline,
        cl.enh_margin_decline,
        cl.program_year_margin,
        cl.tier2_margin_decline,
        cl.tier2_benefit,
        cl.tier3_trigger,
        cl.tier3_margin_decline,
        cl.enh_positive_margin_decline,
        cl.tier3_benefit,
        cl.enh_positive_margin_benefit,
        cl.enh_negative_margin_benefit,
        cl.negative_margin_decline,
        cl.negative_margin_benefit,
        cl.standard_benefit,
        cl.enh_additional_benefit,
        cl.enh_total_benefit,
        cl.total_benefit,
        COALESCE(cl.prod_insur_deemed_benefit, 0) prod_insur_deemed_benefit,
        (cl.interim_benefit_percent * 100) interim_benefit_percent,
        cl.supply_managed_commodities_adj,
        cl.benefit_before_deductions,
        cl.enh_benefit_before_deductions,
        COALESCE(
            COALESCE(cl.benefit_after_prod_insur_ded, cl.benefit_before_deductions),
            0
        ) benefit_after_prod_insur_ded,
        COALESCE(
            COALESCE(cl.enh_benefit_after_prodins_ded, cl.enh_benefit_before_deductions),
            0
        ) enh_benefit_after_prodins_ded,
        COALESCE(
            COALESCE(
                cl.benefit_after_interim_ded,
                COALESCE(cl.benefit_after_prod_insur_ded, cl.benefit_before_deductions)
            ),
            0
        ) benefit_after_interim_ded,
        COALESCE(
            COALESCE(
                cl.enh_benefit_after_interim_ded,
                COALESCE(cl.enh_benefit_after_prodins_ded, cl.enh_benefit_before_deductions)
            ),
            0
        ) enh_benefit_after_interim_ded,
        COALESCE(
            COALESCE(
                cl.benefit_after_payment_cap,
                COALESCE(
                    cl.benefit_after_interim_ded,
                    COALESCE(cl.benefit_after_prod_insur_ded, cl.benefit_before_deductions)
                )
            ),
            0
        ) benefit_after_payment_cap,
        COALESCE(
            COALESCE(
                cl.enh_benefit_after_payment_cap,
                COALESCE(
                    cl.enh_benefit_after_interim_ded,
                    COALESCE(cl.enh_benefit_after_prodins_ded, cl.enh_benefit_before_deductions)
                )
            ),
            0
        ) enh_benefit_after_payment_cap,
        cl.payment_cap,
        cl.late_enrolment_penalty * -1 late_enrolment_penalty,
        cl.bnft_after_late_enrol_penalty orig_bnft_after_late_enrol_penalty,
        cl.benefit_after_appl_benefit_pct,
        cl.late_enr_pnlty_aft_apl_ben_pct,
        cl.enh_late_enrolment_penalty * -1 enh_late_enrolment_penalty,
        cl.enh_bnft_aftr_late_enr_penalty orig_enh_bnft_aftr_late_enr_penalty,
        cl.enh_bnft_aftr_applied_bnft_pct,
        cl.enh_lat_en_pnlty_af_apl_bn_pct,
        (cl.applied_benefit_percent * 100) applied_benefit_percent,
        fas.combined_farm_number,
        fas.scenario_category_code,
        ppmcr.parameter_value agri_positive_margin_comp_rate,
        pnmcr.parameter_value agri_negative_margin_comp_rate,
        pbcpmcr.parameter_value bc_enh_pos_margin_comp_rate,
        pbcnmcr.parameter_value bc_enh_neg_margin_comp_rate,
        pplptmd.parameter_value payment_limitation_percent,
        3000000 max_benefit,
        6200000 enh_max_benefit,
        CASE
            WHEN cl.enh_additional_benefit IS NOT NULL
            THEN 'Under the AgriStability SCAP Agreement and BC Enhancement, the benefit payment is capped at the lesser of the Payment Limitation or $6.2 Million ($3 Million and $3.2 Million Enhancement)'
            ELSE 'Under the AgriStability SCAP Agreement, the benefit payment is capped at the lesser of the Payment Limitation or $3 Million'
        END max_benefit_text
    FROM farms.farm_program_years py
    JOIN farms.farm_program_year_versions pyv
        ON pyv.program_year_id = py.program_year_id
    LEFT JOIN farms.farm_municipality_codes mc
        ON mc.municipality_code = pyv.municipality_code
    JOIN farms.farm_agristability_clients ac
        ON ac.agristability_client_id = py.agristability_client_id
    JOIN farms.farm_agristability_scenarios fas
        ON fas.program_year_version_id = pyv.program_year_version_id
    JOIN farms.farm_persons psn
        ON psn.person_id = ac.person_id
    JOIN farms.farm_agristability_claims cl
        ON cl.agristability_scenario_id = fas.agristability_scenario_id
    JOIN farms.farm_year_configuration_params ppmcr
        ON ppmcr.program_year = py.year
        AND ppmcr.parameter_name =
            'AgriStability Benefit - Positive Margin Compensation Rate Percentage'
    JOIN farms.farm_year_configuration_params pnmcr
        ON pnmcr.program_year = py.year
        AND pnmcr.parameter_name =
            'AgriStability Benefit - Negative Margin Compensation Rate Percentage'
    JOIN farms.farm_year_configuration_params pbcpmcr
        ON pbcpmcr.program_year = py.year
        AND pbcpmcr.parameter_name =
            'BC Enhanced Benefit - Positive Margin Compensation Rate Percentage'
    JOIN farms.farm_year_configuration_params pbcnmcr
        ON pbcnmcr.program_year = py.year
        AND pbcnmcr.parameter_name =
            'BC Enhanced Benefit - Negative Margin Compensation Rate Percentage'
    JOIN farms.farm_year_configuration_params pplptmd
        ON pplptmd.program_year = py.year
        AND pplptmd.parameter_name =
            'Payment Limitation - Percentage of Total Margin Decline'
    WHERE fas.agristability_scenario_id = $P{IN_SCENARIO_ID}
) a</queryString>
