  <subDataset name="DS_YARDAGE_EXPENSE" uuid="ebae523b-9a4f-4be1-8cb8-1588db82979c">
    <property name="com.jaspersoft.studio.data.sql.tables" value="" />
    <parameter name="IN_SCENARIO_ID" class="java.lang.Integer">

    </parameter>
    <parameter name="V_YEAR" class="java.lang.Integer">
      <defaultValueExpression><![CDATA[2025]]></defaultValueExpression>
    </parameter>
    <queryString language="SQL">select
  sum(year_minus_5_grower_expense)
    year_minus_5_yardage_expense,
  sum(year_minus_4_grower_expense)
    year_minus_4_yardage_expense,
  sum(year_minus_3_grower_expense)
    year_minus_3_yardage_expense,
  sum(year_minus_2_grower_expense)
    year_minus_2_yardage_expense,
  sum(year_minus_1_grower_expense)
    year_minus_1_yardage_expense,
  sum(year_grower_expense)
    year_yardage_expense
from (
  select
    case
      when py.year = $P{V_YEAR}-5 then bct.yardage_expenses
      else null
    end year_minus_5_grower_expense,
    case
      when py.year = $P{V_YEAR}-4 then bct.yardage_expenses
      else null
    end year_minus_4_grower_expense,
    case
      when py.year = $P{V_YEAR}-3 then bct.yardage_expenses
      else null
    end year_minus_3_grower_expense,
    case
      when py.year = $P{V_YEAR}-2 then bct.yardage_expenses
      else null
    end year_minus_2_grower_expense,
    case
      when py.year = $P{V_YEAR}-1 then bct.yardage_expenses
      else null
    end year_minus_1_grower_expense,
    null year_grower_expense
  from farms.farm_reference_scenarios refs
  join farms.farm_agristability_scenarios fas
    on fas.agristability_scenario_id =
       refs.agristability_scenario_id
  join farms.farm_program_year_versions pyv
    on fas.program_year_version_id =
       pyv.program_year_version_id
  join farms.farm_program_years py
    on py.program_year_id = pyv.program_year_id
  join farms.farm_benefit_calc_totals bct
    on bct.agristability_scenario_id =
       fas.agristability_scenario_id
  where refs.for_agristability_scenario_id =
        $P{IN_SCENARIO_ID}

  union all

  select
    null year_minus_5_grower_expense,
    null year_minus_4_grower_expense,
    null year_minus_3_grower_expense,
    null year_minus_2_grower_expense,
    null year_minus_1_grower_expense,
    bct.yardage_expenses year_grower_expense
  from farms.farm_agristability_scenarios fas
  join farms.farm_benefit_calc_totals bct
    on bct.agristability_scenario_id =
       fas.agristability_scenario_id
  where fas.agristability_scenario_id =
        $P{IN_SCENARIO_ID}
) AS pg_derived_1</queryString>
