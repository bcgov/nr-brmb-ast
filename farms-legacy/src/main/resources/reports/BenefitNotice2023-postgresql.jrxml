  <subDataset name="DS_INCOME_ADJUSTMENTS" uuid="1aea120e-37b0-43d9-95c2-a56738a7778a">
    <property name="com.jaspersoft.studio.data.sql.tables" value="" />
    <parameter name="IN_SCENARIO_ID" class="java.lang.Integer">

    </parameter>
    <queryString language="SQL">with state_history as (
  select max(ssa.when_created) verified_date
  from farms.farm_scenario_state_audits ssa
  where ssa.agristability_scenario_id =
        $P{IN_SCENARIO_ID}
    and ssa.scenario_state_code = 'COMP'
)
select
  li.line_item income_adj_code,
  li.description income_adj_description,
  cra.amount income_cra_amount,
  adj.amount income_adj_amount,
  COALESCE(cra.amount, 0) + COALESCE(adj.amount, 0)
    income_new_amount
from farms.farm_scenarios_vw m
join farms.farm_agristability_scenarios s
  on s.agristability_scenario_id =
     m.agristability_scenario_id
join farms.farm_farming_operations fo
  on fo.program_year_version_id =
     m.program_year_version_id
join farms.farm_reported_income_expenses adj
  on adj.farming_operation_id =
     fo.farming_operation_id
 and adj.agristability_scenario_id =
     m.agristability_scenario_id
left outer join farms.farm_reported_income_expenses cra
  on cra.reported_income_expense_id =
     adj.cra_reported_income_expense_id
join farms.farm_line_items li
  on li.line_item = adj.line_item
 and li.program_year = m.year
 and (
   select verified_date
   from state_history
 ) between li.established_date and li.expiry_date
where m.agristability_scenario_id =
      $P{IN_SCENARIO_ID}
  and adj.expense_ind = 'N'
  and adj.amount != 0
order by income_adj_code</queryString>
    <field name="INCOME_ADJ_CODE" class="java.math.BigDecimal">
      <property name="com.jaspersoft.studio.field.label" value="INCOME_ADJ_CODE" />
    </field>
    <field name="INCOME_ADJ_DESCRIPTION" class="java.lang.String">
      <property name="com.jaspersoft.studio.field.label" value="INCOME_ADJ_DESCRIPTION" />
    </field>
    <field name="INCOME_CRA_AMOUNT" class="java.math.BigDecimal">
      <property name="com.jaspersoft.studio.field.label" value="INCOME_CRA_AMOUNT" />
    </field>
    <field name="INCOME_ADJ_AMOUNT" class="java.math.BigDecimal">
      <property name="com.jaspersoft.studio.field.label" value="INCOME_ADJ_AMOUNT" />
    </field>
    <field name="INCOME_NEW_AMOUNT" class="java.math.BigDecimal">
      <property name="com.jaspersoft.studio.field.label" value="INCOME_NEW_AMOUNT" />
    </field>
  </subDataset>
