    <band height="190" splitType="Prevent">
      <textField isStretchWithOverflow="true">
        <reportElement x="12" y="10" width="548" height="180" uuid="c81fc688-fc86-44b8-b8ca-9c6bdba42ea3" />
        <textElement textAlignment="Left" verticalAlignment="Top" markup="styled">
          <font fontName="Arial" size="10" />
        </textElement>
        <textFieldExpression><![CDATA["If you disagree with an assessment, you can request an adjustment within <b>18 months</b> of your original Calculation of Program Benefits notice or file an official appeal within <b>90 days</b> of a decision."
+ "\n\nFor regular participation, you must enroll and pay your fees by <b>April 30</b> and submit your annual tax data by <b>June 30</b> (both accept late entries with financial penalties)."
+ "\n\nAdditionally, if your farm experiences a severe income drop of 30% or more, you can request an Advance Payment by <b>March 31</b> of the following year to access up to 50% of your benefit early."
+ "\n\nAll applications can be completed quickly using the online forms available on our website at <style forecolor=\"#0563C1\" isUnderline=\"true\">gov.bc.ca/AgriStability</style>, or you can contact the B.C. AgriStability team for support by emailing <style forecolor=\"#0563C1\" isUnderline=\"true\">AgriStability@gov.bc.ca</style> or calling toll-free at 1-877-343-2767."]]></textFieldExpression>
      </textField>
    </band>
